# Deployer private key — never commit the real value
PRIVATE_KEY=0x...

# Address that will own both contracts after deployment
OWNER_ADDRESS=0x...

# Staking configuration
STAKING_PERIOD=2592000        # seconds (30 days)
FIX_STAKING_AMOUNT=1000000000000000000  # 1 STK (18 decimals)
REWARD_PER_PERIOD=10000000000000000     # 0.01 ETH in wei

# RPC endpoint for the target network
RPC_URL=http://127.0.0.1:8545  # local Anvil by default
